{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "q3-00",
   "metadata": {},
   "source": [
    "# Q3 — Spark DataFrames and Spark SQL: **master** notebook\n",
    "\n",
    "The same `wiki.recentchange.raw` snapshot as Q2, but through the DataFrame/SQL engine:\n",
    "an explicit schema (never `inferSchema`), a derived `selisih_byte` column, four SQL\n",
    "questions, window-based spike detection, and a physical-plan optimisation.\n",
    "\n",
    "| cell | answers |\n",
    "|---|---|\n",
    "| 1 | explicit `StructType`, timestamp cast, `selisih_byte`, temp view — **Q3a** |\n",
    "| 2 | edits per minute for the top-5 wikis — **Q3b-1** |\n",
    "| 3 | bot vs human percentages + consistency with the Q2 RDDs — **Q3b-2** |\n",
    "| 4 | mean / `percentile_approx` median of `abs(selisih_byte)` per event type — **Q3b-3** |\n",
    "| 5 | top-10 `idwiki` pages by unique editors — **Q3b-4** |\n",
    "| 6 | distribution → `k` (99th percentile) → 5-minute `window()` spikes — **Q3c** |\n",
    "| 7 | `explain()` with `Exchange`/`HashAggregate`, tied to real stages — **Q3d** |\n",
    "| 8 | two optimisations measured: shuffle partitions, broadcast join — **Q3d** |\n",
    "\n",
    "Run order does not matter beyond top-to-bottom; the notebook re-reads the topic itself.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "q3-01",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json, os, re, time, operator, urllib.request, pathlib\n",
    "from contextlib import redirect_stdout\n",
    "from io import StringIO\n",
    "\n",
    "import pandas as pd\n",
    "from pyspark.sql import SparkSession, functions as F\n",
    "from pyspark.sql.types import (StructType, StructField, StringType, LongType,\n",
    "                               IntegerType, BooleanType)\n",
    "\n",
    "# ------------------------------------------------------------------ config\n",
    "BOOTSTRAP   = os.environ.get(\"KAFKA_BOOTSTRAP\", \"10.8.0.6:29092\")\n",
    "TOPIC       = \"wiki.recentchange.raw\"\n",
    "MASTER_URL  = \"spark://10.8.0.6:7077\"\n",
    "MASTER_UI   = \"http://10.8.0.6:8080\"\n",
    "SHARED_ROOT = pathlib.Path(os.environ.get(\"Q_SHARED_DIR\", \"/tmp/spark-events\"))\n",
    "Q2_RESULTS  = SHARED_ROOT / \"q2\" / \"master_results.json\"\n",
    "Q3_OUT      = SHARED_ROOT / \"q3\" / \"q3_results.json\"\n",
    "\n",
    "# ------------------------------------------------------------------ helpers\n",
    "def ui_json(sc, path, timeout=20):\n",
    "    base = sc.uiWebUrl.rstrip(\"/\") + \"/api/v1/applications/\" + sc.applicationId\n",
    "    with urllib.request.urlopen(base + path, timeout=timeout) as fh:\n",
    "        return json.load(fh)\n",
    "\n",
    "\n",
    "def http_json(url, timeout=10):\n",
    "    with urllib.request.urlopen(url, timeout=timeout) as fh:\n",
    "        return json.load(fh)\n",
    "\n",
    "\n",
    "def _get(r, c):\n",
    "    \"\"\"Value of column c from a dict, a Spark Row or any mapping-like object.\"\"\"\n",
    "    if hasattr(r, \"asDict\"):\n",
    "        r = r.asDict(recursive=True)\n",
    "    if isinstance(r, dict):\n",
    "        return r.get(c, \"\")\n",
    "    try:\n",
    "        return r[c]\n",
    "    except Exception:                            # noqa: BLE001\n",
    "        return \"\"\n",
    "\n",
    "\n",
    "def table(rows, cols, title=\"\", max_rows=None):\n",
    "    rows = list(rows)\n",
    "    shown = rows if max_rows is None else rows[:max_rows]\n",
    "    w = {c: max(len(str(c)), 6, *(len(str(_get(r, c))) for r in shown)) if shown else len(str(c))\n",
    "         for c in cols}\n",
    "    out = []\n",
    "    if title:\n",
    "        out.append(title)\n",
    "    out.append(\"  \".join(f\"{str(c):>{w[c]}}\" for c in cols))\n",
    "    out.append(\"-\" * (sum(w.values()) + 2 * (len(cols) - 1)))\n",
    "    for r in shown:\n",
    "        out.append(\"  \".join(f\"{str(_get(r, c)):>{w[c]}}\" for c in cols))\n",
    "    if max_rows is not None and len(rows) > max_rows:\n",
    "        out.append(f\"... {len(rows) - max_rows} more rows\")\n",
    "    text = chr(10).join(out)\n",
    "    print(text)\n",
    "    return text\n",
    "\n",
    "\n",
    "def fmt_bytes(n):\n",
    "    n = float(n or 0)\n",
    "    for unit in (\"B\", \"KiB\", \"MiB\", \"GiB\"):\n",
    "        if n < 1024 or unit == \"GiB\":\n",
    "            return f\"{n:.1f} {unit}\"\n",
    "        n /= 1024.0\n",
    "\n",
    "\n",
    "_SEEN = {\"stages\": set(), \"jobs\": set()}\n",
    "RECORDS = []\n",
    "\n",
    "\n",
    "def measure(sc, label, fn):\n",
    "    \"\"\"Run one action/query under a job group and record jobs/stages/tasks/shuffle/seconds.\"\"\"\n",
    "    tag = f\"q3::{label}\"\n",
    "    try:\n",
    "        sc.setJobGroup(tag, label, False)\n",
    "    except TypeError:\n",
    "        sc.setJobGroup(tag, label)\n",
    "\n",
    "    t0 = time.perf_counter()\n",
    "    result = fn()\n",
    "    seconds = time.perf_counter() - t0\n",
    "\n",
    "    try:\n",
    "        job_ids = list(sc.statusTracker().getJobIdsForGroup(tag))\n",
    "    except Exception:                            # noqa: BLE001\n",
    "        job_ids = []\n",
    "\n",
    "    stages, jobs = {}, []\n",
    "    try:\n",
    "        jobs = ui_json(sc, \"/jobs\")\n",
    "        stages = {s[\"stageId\"]: s for s in ui_json(sc, \"/stages\")}\n",
    "    except Exception:                            # noqa: BLE001\n",
    "        pass\n",
    "\n",
    "    mine = [j for j in jobs if j[\"jobId\"] in job_ids]\n",
    "    _SEEN[\"jobs\"].update(j[\"jobId\"] for j in mine)\n",
    "    stage_ids = sorted({sid for j in mine for sid in j.get(\"stageIds\", [])})\n",
    "    sel = [stages[sid] for sid in stage_ids if sid in stages]\n",
    "    rec = {\"label\": label, \"seconds\": round(seconds, 3), \"jobs\": len(mine),\n",
    "           \"stage_ids\": stage_ids, \"stages\": len(sel),\n",
    "           \"tasks\": sum(s.get(\"numTasks\", 0) for s in sel),\n",
    "           \"shuffle_write\": sum(s.get(\"shuffleWriteBytes\", 0) for s in sel),\n",
    "           \"shuffle_read\": sum(s.get(\"shuffleReadBytes\", 0) for s in sel)}\n",
    "    RECORDS.append(rec)\n",
    "    return result\n",
    "\n",
    "\n",
    "def physical_plan(df):\n",
    "    \"\"\"Only the physical-plan section of explain('formatted') — the part Q3d asks about.\"\"\"\n",
    "    txt = plan_text(df, \"formatted\")\n",
    "    marker = \"== Physical Plan ==\"\n",
    "    return \"== Physical Plan ==\" + txt.split(marker, 1)[1] if marker in txt else txt\n",
    "\n",
    "\n",
    "def plan_text(df, mode=\"formatted\"):\n",
    "    \"\"\"Physical plan as text (no need to scrape stdout).\"\"\"\n",
    "    try:\n",
    "        return df._jdf.queryExecution().explainString(mode)\n",
    "    except Exception:                            # noqa: BLE001\n",
    "        buf = StringIO()\n",
    "        with redirect_stdout(buf):\n",
    "            df.explain(mode if mode != \"formatted\" else True)\n",
    "        return buf.getvalue()\n"
   ]
  },
  {
