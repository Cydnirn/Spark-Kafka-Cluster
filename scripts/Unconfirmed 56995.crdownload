      "2026-11-16 13:47:00          323      19     105      30           525\n",
      "\n",
      "Q3b-1 — first 15 minute/wikis rows\n",
      "             minute          wiki   edits\n",
      "-----------------------------------------\n",
      "2026-11-16 12:42:00  wikidatawiki      16\n",
      "2026-11-16 12:42:00   commonswiki      12\n",
      "2026-11-16 12:42:00        enwiki       8\n",
      "2026-11-16 12:42:00        frwiki       3\n",
      "2026-11-16 12:42:00        dewiki       1\n",
      "2026-11-16 12:43:00  wikidatawiki     317\n",
      "2026-11-16 12:43:00   commonswiki     297\n",
      "2026-11-16 12:43:00        enwiki      92\n",
      "2026-11-16 12:43:00        dewiki      26\n",
      "2026-11-16 12:43:00        frwiki      23\n",
      "2026-11-16 12:44:00   commonswiki     305\n",
      "2026-11-16 12:44:00  wikidatawiki     276\n",
      "2026-11-16 12:44:00        enwiki      67\n",
      "2026-11-16 12:44:00        dewiki      23\n",
      "2026-11-16 12:44:00        frwiki      11\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "'Q3b-1 — first 15 minute/wikis rows\\n             minute          wiki   edits\\n-----------------------------------------\\n2026-11-16 12:42:00  wikidatawiki      16\\n2026-11-16 12:42:00   commonswiki      12\\n2026-11-16 12:42:00        enwiki       8\\n2026-11-16 12:42:00        frwiki       3\\n2026-11-16 12:42:00        dewiki       1\\n2026-11-16 12:43:00  wikidatawiki     317\\n2026-11-16 12:43:00   commonswiki     297\\n2026-11-16 12:43:00        enwiki      92\\n2026-11-16 12:43:00        dewiki      26\\n2026-11-16 12:43:00        frwiki      23\\n2026-11-16 12:44:00   commonswiki     305\\n2026-11-16 12:44:00  wikidatawiki     276\\n2026-11-16 12:44:00        enwiki      67\\n2026-11-16 12:44:00        dewiki      23\\n2026-11-16 12:44:00        frwiki      11'"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "per_minute_sql = \"\"\"\n",
    "WITH top5 AS (\n",
    "    SELECT wiki, COUNT(*) AS edits\n",
    "    FROM wiki_edits\n",
    "    WHERE type = 'edit'\n",
    "    GROUP BY wiki\n",
    "    ORDER BY edits DESC\n",
    "    LIMIT 5\n",
    ")\n",
    "SELECT date_trunc('minute', event_ts) AS minute,\n",
    "       wiki,\n",
    "       COUNT(*)                       AS edits\n",
    "FROM wiki_edits\n",
    "WHERE type = 'edit'\n",
    "  AND wiki IN (SELECT wiki FROM top5)\n",
    "GROUP BY date_trunc('minute', event_ts), wiki\n",
    "\"\"\"\n",
    "per_minute = measure(sc, \"(b-1) edits per minute, top 5 wikis\",\n",
    "                     lambda: spark.sql(per_minute_sql).toPandas())\n",
    "print(f\"minute x wiki rows: {len(per_minute)}\")\n",
    "print(f\"minutes covered   : {per_minute['minute'].nunique()} \"\n",
    "      f\"({per_minute['minute'].min()} → {per_minute['minute'].max()})\")\n",
    "print(\"note: the snapshot contains two separate producer runs, so the minute series has a \"\n",
    "      \"gap; nothing is missing inside a run (the KPI is edits per minute, not per captured minute)\")\n",
    "\n",
    "pivot = per_minute.pivot_table(index=\"minute\", columns=\"wiki\", values=\"edits\",\n",
    "                               fill_value=0).sort_index()\n",
    "busiest = pivot.sum(axis=1).sort_values(ascending=False).index[:12]\n",
    "print()\n",
    "print(pivot.loc[sorted(busiest)].astype(int).to_string())\n",
    "\n",
    "print()\n",
    "table(spark.sql(per_minute_sql + \" ORDER BY minute, edits DESC\").limit(15).collect(),\n",
    "      [\"minute\", \"wiki\", \"edits\"], title=\"Q3b-1 — first 15 minute/wikis rows\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "q3-07",
   "metadata": {},
   "source": [
    "## Q3b-2 — bot vs human percentages per wiki, and consistency with Q2\n",
    "\n",
    "`SUM(CASE WHEN bot THEN 1 ELSE 0 END)` over `type='edit'` gives the split; percentages are\n",
    "rounded to two decimals.\n",
    "\n",
    "The consistency check has two independent legs:\n",
    "\n",
    "1. **against Q2's saved results** — the RDD run stored `top_wikis` (human edits per wiki).\n",
    "   The SQL ranking must reproduce that list exactly;\n",
    "2. **against an RDD recomputed here** — the same DataFrame is pushed back to an RDD and the\n",
    "   Q2 aggregation is repeated, so the comparison holds even if the Q2 file is missing.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "q3-08",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Q3b-2 — bot vs human share per wiki (top 15 of 175 wikis)\n",
      "         wiki   edits  bot_edits  human_edits  bot_pct  human_pct\n",
      "-----------------------------------------------------------------\n",
      " wikidatawiki   11388        177        11211     1.55      98.45\n",
      "  commonswiki    7170       3641         3529    50.78      49.22\n",
      "       enwiki    2165        320         1845    14.78      85.22\n",
      "       frwiki     615        241          374    39.19      60.81\n",
      "       dewiki     543         67          476    12.34      87.66\n",
      "       zhwiki     435        188          247    43.22      56.78\n",
      "       arwiki     397        335           62    84.38      15.62\n",
      "       ruwiki     284         30          254    10.56      89.44\n",
      "       jawiki     267         43          224    16.10      83.90\n",
      "       itwiki     227         40          187    17.62      82.38\n",
      "       eswiki     223         61          162    27.35      72.65\n",
      "       urwiki     222        212           10    95.50       4.50\n",
      "       plwiki     193        118           75    61.14      38.86\n",
      "yuewiktionary     175          0          175     0.00     100.00\n",
      "       shwiki     173        171            2    98.84       1.16\n",
      "... 160 more rows\n",
      "\n",
      "Q3b-2 — SQL vs RDD for the same human-edit counts\n",
      "         wiki  SQL human_edits  RDD human_edits\n",
      "-----------------------------------------------\n",
      " wikidatawiki            11211            11211\n",
      "  commonswiki             3529             3529\n",
      "       enwiki             1845             1845\n",
      "       dewiki              476              476\n",
      "       frwiki              374              374\n",
      "       ruwiki              254              254\n",
      "       zhwiki              247              247\n",
      "       jawiki              224              224\n",
      "       itwiki              187              187\n",
      "yuewiktionary              175              175\n",
      "top-10 lists identical: True\n",
      "Q2 results loaded (master_results.json, 57,778 messages)\n",
      "identical to Q2's RDD top-10: True\n"
     ]
    }
   ],
   "source": [
    "bot_sql = \"\"\"\n",
    "SELECT wiki,\n",
    "       COUNT(*)                                                        AS edits,\n",
    "       SUM(CASE WHEN bot THEN 1 ELSE 0 END)                            AS bot_edits,\n",
    "       SUM(CASE WHEN NOT bot THEN 1 ELSE 0 END)                        AS human_edits,\n",
    "       ROUND(100.0 * SUM(CASE WHEN bot THEN 1 ELSE 0 END) / COUNT(*), 2)     AS bot_pct,\n",
    "       ROUND(100.0 * SUM(CASE WHEN NOT bot THEN 1 ELSE 0 END) / COUNT(*), 2) AS human_pct\n",
    "FROM wiki_edits\n",
    "WHERE type = 'edit'\n",
    "GROUP BY wiki\n",
    "ORDER BY edits DESC\n",
    "\"\"\"\n",
    "bot_rows = measure(sc, \"(b-2) bot vs human per wiki\", lambda: spark.sql(bot_sql).collect())\n",
    "table(bot_rows, [\"wiki\", \"edits\", \"bot_edits\", \"human_edits\", \"bot_pct\", \"human_pct\"],\n",
    "      title=\"Q3b-2 — bot vs human share per wiki (top 15 of %d wikis)\" % len(bot_rows),\n",
    "      max_rows=15)\n",
    "\n",
    "# --- leg 2: same aggregation through the RDD API (Q2 code) -------------------\n",
    "rdd_human = (edits.select(\"wiki\", \"type\", \"bot\").rdd\n",
    "             .filter(lambda r: r[\"type\"] == \"edit\" and r[\"bot\"] is False)\n",
    "             .map(lambda r: (r[\"wiki\"], 1))\n",
    "             .reduceByKey(operator.add)\n",
    "             .takeOrdered(10, key=lambda kv: (-kv[1], kv[0])))\n",
    "sql_human = sorted(((r[\"wiki\"], r[\"human_edits\"]) for r in bot_rows),\n",
    "                   key=lambda kv: (-kv[1], kv[0]))[:10]\n",
    "print()\n",
    "table([{\"wiki\": w, \"SQL human_edits\": c,\n",
    "        \"RDD human_edits\": dict(sql_human).get(w)} for w, c in rdd_human],\n",
    "      [\"wiki\", \"SQL human_edits\", \"RDD human_edits\"],\n",
    "      title=\"Q3b-2 — SQL vs RDD for the same human-edit counts\")\n",
    "print(\"top-10 lists identical:\", [tuple(x) for x in rdd_human] == sql_human)\n",
    "\n",
    "# --- leg 1: against the Q2 notebook's saved output ---------------------------\n",
    "try:\n",
    "    q2 = json.loads(Q2_RESULTS.read_text())\n",
    "    q2_top = [tuple(x) for x in q2[\"top_wikis\"]]\n",
    "    print(f\"Q2 results loaded ({Q2_RESULTS.name}, {q2['messages']:,} messages)\")\n",
    "    print(\"identical to Q2's RDD top-10:\", q2_top == [tuple(x) for x in rdd_human])\n",
    "    if q2_top != [tuple(x) for x in rdd_human]:\n",
    "        print(\"  Q2 :\", q2_top[:5])\n",
    "        print(\"  SQL:\", [tuple(x) for x in rdd_human][:5])\n",
    "except FileNotFoundError:\n",
    "    print(f\"{Q2_RESULTS} not found — skipped the comparison with the Q2 run \"\n",
    "          f\"(run q2_spark_master.ipynb first for that check)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "q3-09",
   "metadata": {},
   "source": [
    "## Q3b-3 — mean and median of `abs(selisih_byte)` per event type\n",
    "\n",
    "Median via `percentile_approx(col, 0.5, 10000)` — an exact median would need a full sort of\n",
    "the column, which is what the approximation avoids on a distributed dataset. `abs()` is\n",
    "applied before aggregating so byte *losses* do not cancel byte *gains*.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "q3-10",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Q3b-3 — absolute byte delta per event type\n",
      "  type  rows_with_bytes  mean_abs_bytes  median_abs_bytes  max_abs_bytes\n",
      "------------------------------------------------------------------------\n",
      "  edit            27733          930.27               228        1842508\n",
      "   new             1903         1220.19               174         110807\n",
      "\n",
      "rows excluded (selisih_byte IS NULL): 28142 — log/categorize events have no page-size numbers, so no delta is defined\n"
     ]
    }
   ],
   "source": [
    "size_sql = \"\"\"\n",
    "SELECT type,\n",
    "       COUNT(selisih_byte)                                     AS rows_with_bytes,\n",
    "       ROUND(AVG(ABS(selisih_byte)), 2)                        AS mean_abs_bytes,\n",
    "       ROUND(PERCENTILE_APPROX(ABS(selisih_byte), 0.5, 10000), 2) AS median_abs_bytes,\n",
    "       MAX(ABS(selisih_byte))                                  AS max_abs_bytes\n",
    "FROM wiki_edits\n",
    "WHERE selisih_byte IS NOT NULL\n",
    "GROUP BY type\n",
    "ORDER BY rows_with_bytes DESC\n",
    "\"\"\"\n",
    "size_rows = measure(sc, \"(b-3) mean/median abs(selisih_byte)\", lambda: spark.sql(size_sql).collect())\n",
    "table(size_rows, [\"type\", \"rows_with_bytes\", \"mean_abs_bytes\", \"median_abs_bytes\",\n",
    "                  \"max_abs_bytes\"], title=\"Q3b-3 — absolute byte delta per event type\")\n",
    "print()\n",
    "print(\"rows excluded (selisih_byte IS NULL):\",\n",
    "      spark.sql(\"SELECT COUNT(*) AS n FROM wiki_edits WHERE selisih_byte IS NULL\").first()[\"n\"],\n",
    "      \"— log/categorize events have no page-size numbers, so no delta is defined\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "q3-11",
   "metadata": {},
   "source": [
    "## Q3b-4 — top 10 `idwiki` pages by number of unique editors\n",
    "\n",
    "`COUNT(DISTINCT user)` over edits (not creates), ordered by unique editors with a\n",
    "deterministic tie-break. Anonymous editors appear as their salted `anon:<hash>` pseudonym,\n",
    "so repeat edits by one IP still collapse into one editor — the anonymisation from Q1 does\n",
    "not break this metric.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "q3-12",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Q3b-4 — top 10 idwiki pages by unique editors\n",
      "                                     title  unique_editors   edits  bot_edits\n",
      "-----------------------------------------------------------------------------\n",
      "                                 Decorient               2       2          0\n",
      "                                       Max               2       2          0\n",
      "           Daftar produk rokok dari Djarum               1       2          0\n",
      "                             Eddy Soeparno               1       2          0\n",
      "                         Keluarga Punaluan               1       2          0\n",
      "Pengguna:XmOffr1c!al77/Berkas:Yogi Supardi               1       2          0\n",
      "                               301 Bavaria               1       1          0\n",
      "                        Abdul Hafid Achmad               1       1          0\n",
      "                              Ahmad Muzani               1       1          0\n",
      "                      ArekMalang Indonesia               1       1          0\n",
      "\n",
      "idwiki edits in the snapshot: 65\n"
     ]
    }
   ],
   "source": [
    "editors_sql = \"\"\"\n",
    "SELECT title,\n",
    "       COUNT(DISTINCT user) AS unique_editors,\n",
    "       COUNT(*)             AS edits,\n",
    "       SUM(CASE WHEN bot THEN 1 ELSE 0 END) AS bot_edits\n",
    "FROM wiki_edits\n",
    "WHERE wiki = 'idwiki' AND type = 'edit' AND user IS NOT NULL\n",
    "GROUP BY title\n",
    "ORDER BY unique_editors DESC, edits DESC, title\n",
    "LIMIT 10\n",
    "\"\"\"\n",
    "editor_rows = measure(sc, \"(b-4) unique editors per idwiki page\",\n",
    "                      lambda: spark.sql(editors_sql).collect())\n",
    "table(editor_rows, [\"title\", \"unique_editors\", \"edits\", \"bot_edits\"],\n",
    "      title=\"Q3b-4 — top 10 idwiki pages by unique editors\")\n",
    "print()\n",
    "print(\"idwiki edits in the snapshot:\",\n",
    "      spark.sql(\"SELECT COUNT(*) AS n FROM wiki_edits WHERE wiki='idwiki' AND type='edit'\")\n",
    "           .first()[\"n\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "q3-13",
   "metadata": {},
   "source": [
    "## Q3c — editing spikes: `k` from the distribution, then a 5-minute `window()`\n",
    "\n",
    "Method:\n",
    "\n",
    "1. bucket every edit into a tumbling **5-minute window per page** (`window(event_ts, '5 minutes')`\n",
    "   grouped by `wiki, title`), giving the count distribution over all page-windows;\n",
    "2. read the percentiles. `k` = the **99th percentile** of that distribution, so a page is\n",
    "   flagged only when its 5-minute edit count is in the top 1 % of all page-windows — the\n",
    "   threshold is derived from the data, not chosen by hand;\n",
    "3. if the 99th percentile is 1 (most page-windows have a single edit, which is normal for a\n",
    "   short capture), the threshold would flag everything, so it falls back to the 99.9th\n",
    "   percentile. The cell prints which of the two was used, with the numbers behind it.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "q3-14",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Q3c — distribution of edits per (wiki, page, 5-minute window)\n",
      "page_windows  max_edits     p50     p90     p99    p999  windows_ge_2  windows_ge_5\n",
      "-----------------------------------------------------------------------------------\n",
      "       22751         54       1       1       6      20          1944           314\n",
      "\n",
      "chosen threshold k = 6 edits / 5 minutes  (rule: p99)\n",
      "reason: 22,751 page-windows, median 1, p99 6, max 54 — k above the median means only the tail of the distribution is flagged\n",
      "Q3c — pages with >= 6 edits in one 5-minute window (247 page-windows)\n",
      "        wiki       title         window_start           window_end   edits\n",
      "--------------------------------------------------------------------------\n",
      "wikidatawiki  Q140953424  2026-11-16 12:50:00  2026-11-16 12:55:00      54\n",
      "wikidatawiki  Q140953354  2026-11-16 12:40:00  2026-11-16 12:45:00      46\n",
      "wikidatawiki   Q57170692  2026-11-16 12:50:00  2026-11-16 12:55:00      38\n",
      "wikidatawiki  Q140953394  2026-11-16 12:45:00  2026-11-16 12:50:00      37\n",
      "wikidatawiki  Q140953421  2026-11-16 12:45:00  2026-11-16 12:50:00      35\n",
      "wikidatawiki  Q140953437  2026-11-16 12:50:00  2026-11-16 12:55:00      34\n",
      "wikidatawiki  Q140953450  2026-11-16 12:50:00  2026-11-16 12:55:00      34\n",
      "wikidatawiki   Q57170720  2026-11-16 13:40:00  2026-11-16 13:45:00      34\n",
      "wikidatawiki   Q57170690  2026-11-16 12:45:00  2026-11-16 12:50:00      30\n",
      "wikidatawiki  Q140953352  2026-11-16 12:40:00  2026-11-16 12:45:00      28\n",
      "wikidatawiki  Q140953378  2026-11-16 12:45:00  2026-11-16 12:50:00      28\n",
      "wikidatawiki   Q57170718  2026-11-16 13:35:00  2026-11-16 13:40:00      28\n",
      "wikidatawiki  Q140953469  2026-11-16 12:50:00  2026-11-16 12:55:00      27\n",
      "wikidatawiki   Q57170693  2026-11-16 12:50:00  2026-11-16 12:55:00      27\n",
      "wikidatawiki  Q140953468  2026-11-16 12:50:00  2026-11-16 12:55:00      26\n",
      "wikidatawiki  Q141829659  2026-11-16 12:50:00  2026-11-16 12:55:00      26\n",
      "wikidatawiki  Q140705255  2026-11-16 13:45:00  2026-11-16 13:50:00      25\n",
      "wikidatawiki  Q140953387  2026-11-16 12:45:00  2026-11-16 12:50:00      25\n",
      "wikidatawiki   Q57170722  2026-11-16 13:45:00  2026-11-16 13:50:00      25\n",
      "wikidatawiki  Q140953444  2026-11-16 12:50:00  2026-11-16 12:55:00      23\n",
      "... 227 more rows\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "'Q3c — pages with >= 6 edits in one 5-minute window (247 page-windows)\\n        wiki       title         window_start           window_end   edits\\n--------------------------------------------------------------------------\\nwikidatawiki  Q140953424  2026-11-16 12:50:00  2026-11-16 12:55:00      54\\nwikidatawiki  Q140953354  2026-11-16 12:40:00  2026-11-16 12:45:00      46\\nwikidatawiki   Q57170692  2026-11-16 12:50:00  2026-11-16 12:55:00      38\\nwikidatawiki  Q140953394  2026-11-16 12:45:00  2026-11-16 12:50:00      37\\nwikidatawiki  Q140953421  2026-11-16 12:45:00  2026-11-16 12:50:00      35\\nwikidatawiki  Q140953437  2026-11-16 12:50:00  2026-11-16 12:55:00      34\\nwikidatawiki  Q140953450  2026-11-16 12:50:00  2026-11-16 12:55:00      34\\nwikidatawiki   Q57170720  2026-11-16 13:40:00  2026-11-16 13:45:00      34\\nwikidatawiki   Q57170690  2026-11-16 12:45:00  2026-11-16 12:50:00      30\\nwikidatawiki  Q140953352  2026-11-16 12:40:00  2026-11-16 12:45:00      28\\nwikidatawiki  Q140953378  2026-11-16 12:45:00  2026-11-16 12:50:00      28\\nwikidatawiki   Q57170718  2026-11-16 13:35:00  2026-11-16 13:40:00      28\\nwikidatawiki  Q140953469  2026-11-16 12:50:00  2026-11-16 12:55:00      27\\nwikidatawiki   Q57170693  2026-11-16 12:50:00  2026-11-16 12:55:00      27\\nwikidatawiki  Q140953468  2026-11-16 12:50:00  2026-11-16 12:55:00      26\\nwikidatawiki  Q141829659  2026-11-16 12:50:00  2026-11-16 12:55:00      26\\nwikidatawiki  Q140705255  2026-11-16 13:45:00  2026-11-16 13:50:00      25\\nwikidatawiki  Q140953387  2026-11-16 12:45:00  2026-11-16 12:50:00      25\\nwikidatawiki   Q57170722  2026-11-16 13:45:00  2026-11-16 13:50:00      25\\nwikidatawiki  Q140953444  2026-11-16 12:50:00  2026-11-16 12:55:00      23\\n... 227 more rows'"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "window_sql = \"\"\"\n",
    "SELECT wiki,\n",
    "       title,\n",
    "       window(event_ts, '5 minutes') AS win,\n",
    "       COUNT(*)                      AS edits\n",
    "FROM wiki_edits\n",
    "WHERE type = 'edit' AND title IS NOT NULL\n",
    "GROUP BY window(event_ts, '5 minutes'), wiki, title\n",
    "\"\"\"\n",
    "spark.sql(window_sql).createOrReplaceTempView(\"page_windows\")\n",
    "\n",
    "dist = measure(sc, \"(c) distribution of page-windows\", lambda: spark.sql(\"\"\"\n",
    "    SELECT COUNT(*)                                        AS page_windows,\n",
    "           MAX(edits)                                      AS max_edits,\n",
    "           PERCENTILE_APPROX(edits, 0.50)                   AS p50,\n",
    "           PERCENTILE_APPROX(edits, 0.90)                   AS p90,\n",
    "           PERCENTILE_APPROX(edits, 0.99)                   AS p99,\n",
    "           PERCENTILE_APPROX(edits, 0.999)                  AS p999,\n",
    "           SUM(CASE WHEN edits >= 2 THEN 1 ELSE 0 END)      AS windows_ge_2,\n",
    "           SUM(CASE WHEN edits >= 5 THEN 1 ELSE 0 END)      AS windows_ge_5\n",
    "    FROM page_windows\n",
    "\"\"\").first())\n",
    "\n",
    "d = dist.asDict()\n",
    "table([d], [\"page_windows\", \"max_edits\", \"p50\", \"p90\", \"p99\", \"p999\",\n",
    "            \"windows_ge_2\", \"windows_ge_5\"],\n",
    "      title=\"Q3c — distribution of edits per (wiki, page, 5-minute window)\")\n",
    "\n",
    "k = int(d[\"p99\"] or 1)\n",
    "rule = \"p99\"\n",
    "if k <= 1:\n",
    "    k = max(int(d[\"p999\"] or 1), 2)\n",
    "    rule = \"p99.9 (floored to 2)\"\n",
    "print()\n",
    "print(f\"chosen threshold k = {k} edits / 5 minutes  (rule: {rule})\")\n",
    "print(f\"reason: {d['page_windows']:,} page-windows, median {d['p50']}, \"\n",
    "      f\"p99 {d['p99']}, max {d['max_edits']} — k above the median means only the tail \"\n",
    "      f\"of the distribution is flagged\")\n",
    "\n",
    "spikes = measure(sc, \"(c) spike pages\", lambda: spark.sql(f\"\"\"\n",
    "    SELECT wiki, title, win.start AS window_start, win.end AS window_end, edits\n",
    "    FROM page_windows\n",
    "    WHERE edits >= {k}\n",
    "    ORDER BY edits DESC, wiki, title\n",
    "\"\"\").collect())\n",
    "table(spikes, [\"wiki\", \"title\", \"window_start\", \"window_end\", \"edits\"],\n",
    "      title=f\"Q3c — pages with >= {k} edits in one 5-minute window \"\n",
    "            f\"({len(spikes)} page-windows)\", max_rows=20)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "q3-15",
   "metadata": {},
   "source": [
    "## Q3d — `explain()`, `Exchange`/`HashAggregate`, and the stages they become\n",
    "\n",
    "`explain(\"formatted\")` is used instead of the one-line plan because it labels each operator\n",
    "and keeps the partial/final aggregation split visible. The chain to look for is\n",
    "\n",
    "```\n",
    "Exchange hashpartitioning(...)          <- boundary between two stages (the shuffle)\n",
    "HashAggregate(..., isPartial = true)    <- map-side combine, same stage as the scan\n",
    "HashAggregate(..., isPartial = false)   <- final merge, stage after the Exchange\n",
    "```\n",
    "\n",
    "The table after the plan is pulled from the driver's REST API for the *same* query (job\n",
    "group), so `Exchange` in the plan can be matched to the stage that actually did the shuffle\n",
    "(its `shuffle write`/`shuffle read` bytes and task count).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "q3-16",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "== Physical Plan ==\n",
      "AdaptiveSparkPlan isFinalPlan=false\n",
      "+- HashAggregate(keys=[wiki#228], functions=[count(1), sum(CASE WHEN bot#233 THEN 1 ELSE 0 END)], output=[wiki#228, edits#6364L, bot_edits#6365L])\n",
      "   +- Exchange hashpartitioning(wiki#228, 8), ENSURE_REQUIREMENTS, [plan_id=1819]\n",
      "      +- HashAggregate(keys=[wiki#228], functions=[partial_count(1), partial_sum(CASE WHEN bot#233 THEN 1 ELSE 0 END)], output=[wiki#228, count#6610L, sum#6611L])\n",
      "         +- Project [wiki#228, bot#233]\n",
      "            +- Filter (isnotnull(type#227) AND (type#227 = edit))\n",
      "               +- InMemoryTableScan [bot#233, type#227, wiki#228], [isnotnull(type#227), (type#227 = edit)]\n",
      "                     +- InMemoryRelation [id#226L, type#227, wiki#228, server_name#229, title#230, namespace#231, user#232, bot#233, minor#234, timestamp#235L, comment#236, length#237, kafka_partition#8, kafka_offset#9L, event_ts#238, selisih_byte#239L], StorageLevel(disk, memory, deserialized, 1 replicas)\n",
      "                           +- *(1) Project [e#7.id AS id#226L, e#7.type AS type#227, e#7.wiki AS wiki#228, e#7.server_name AS server_name#229, e#7.title AS title#230, e#7.namespace AS namespace#231, e#7.user AS user#232, e#7.bot AS bot#233, e#7.minor AS minor#234, e#7.timestamp AS timestamp#235L, e#7.comment AS comment#236, e#7.length AS length#237, kafka_partition#8, kafka_offset#9L, cast(e#7.timestamp as timestamp) AS event_ts#238, (e#7.length.new - coalesce(e#7.length.old, 0)) AS selisih_byte#239L]\n",
      "                              +- *(1) Filter isnotnull(e#7.wiki)\n",
      "                                 +- InMemoryTableScan [e#7, kafka_offset#9L, kafka_partition#8], [isnotnull(e#7.wiki)]\n",
      "                                       +- InMemoryRelation [e#7, kafka_partition#8, kafka_offset#9L], StorageLevel(disk, memory, deserialized, 1 replicas)\n",
      "                                             +- Project [from_json(StructField(id,LongType,true), StructField(type,StringType,true), StructField(wiki,StringType,true), StructField(server_name,StringType,true), StructField(title,StringType,true), StructField(namespace,IntegerType,true), StructField(user,StringType,true), StructField(bot,BooleanType,true), StructField(minor,BooleanType,true), StructField(timestamp,LongType,true), StructField(comment,StringType,true), StructField(length,StructType(StructField(old,LongType,true),StructField(new,LongType,true)),true), cast(value#1 as string), Some(Etc/UTC), false) AS e#7, partition#3 AS kafka_partition#8, offset#4L AS kafka_offset#9L]\n",
      "                                                +- *(1) Scan KafkaRelation(strategy=Subscribe[wiki.recentchange.raw], start=EarliestOffsetRangeLimit, end=LatestOffsetRangeLimit) [key#0,value#1,topic#2,partition#3,offset#4L,timestamp#5,timestampType#6] PushedFilters: [], ReadSchema: struct<key:binary,value:binary,topic:string,partition:int,offset:bigint,timestamp:timestamp,times...\n",
      "\n",
      "\n",
      "\n",
      "(the parsed/analyzed/optimized logical plans are one call away: df.explain('extended'))\n",
      "\n",
      "--- operators that matter for the stage boundary ---\n",
      "  AdaptiveSparkPlan isFinalPlan=false\n",
      "  +- HashAggregate(keys=[wiki#228], functions=[count(1), sum(CASE WHEN bot#233 THEN 1 ELSE 0 END)], output=[wiki#228, edits#6364L, bot_edits#6365L])\n",
      "  +- Exchange hashpartitioning(wiki#228, 8), ENSURE_REQUIREMENTS, [plan_id=1819]\n",
      "  +- HashAggregate(keys=[wiki#228], functions=[partial_count(1), partial_sum(CASE WHEN bot#233 THEN 1 ELSE 0 END)], output=[wiki#228, count#6610L, sum#6\n",
      "\n",
      "query returned 175 wiki rows in 0.131 s\n",
      "Q3d — the stages of that job (Spark UI numbers, via REST)\n",
      " stage                                              name   tasks  shuffle write  shuffle read\n",
      "---------------------------------------------------------------------------------------------\n",
      "    75  collect at /tmp/ipykernel_10008/2722576989.py:23       6        6.5 KiB         0.0 B\n",
      "    76  collect at /tmp/ipykernel_10008/2722576989.py:23       6          0.0 B         0.0 B\n",
      "    77  collect at /tmp/ipykernel_10008/2722576989.py:23       1          0.0 B       6.5 KiB\n",
      "\n",
      "reading: the stage that WRITES shuffle bytes carries the partial HashAggregate\n",
      "         (map-side combine, on the scan); the stage that READS them carries the\n",
      "         final HashAggregate, i.e. everything after the Exchange in the plan.\n"
     ]
    }
   ],
   "source": [
    "agg_sql = \"\"\"\n",
    "SELECT wiki,\n",
    "       COUNT(*)                          AS edits,\n",
    "       SUM(CASE WHEN bot THEN 1 ELSE 0 END) AS bot_edits\n",
    "FROM wiki_edits\n",
    "WHERE type = 'edit'\n",
    "GROUP BY wiki\n",
    "\"\"\"\n",
    "agg_df = spark.sql(agg_sql)\n",
    "\n",
    "full_plan = physical_plan(agg_df)\n",
    "print(full_plan)\n",
    "print()\n",
    "print(\"(the parsed/analyzed/optimized logical plans are one call away: df.explain('extended'))\")\n",
    "print()\n",
    "print(\"--- operators that matter for the stage boundary ---\")\n",
    "for line in full_plan.splitlines():\n",
    "    s = line.strip()\n",
    "    if any(op in s for op in (\"Exchange\", \"HashAggregate\", \"AdaptiveSparkPlan\",\n",
    "                              \"isFinalPlan\", \"Scan kafka\")):\n",
    "        print(\"  \" + s[:150])\n",
    "\n",
    "rows = measure(sc, \"(d) aggregation job\", lambda: agg_df.collect())\n",
    "print()\n",
    "print(f\"query returned {len(rows)} wiki rows in {RECORDS[-1]['seconds']} s\")\n",
    "\n",
    "stage_rows = []\n",
    "for sid in RECORDS[-1][\"stage_ids\"]:\n",
    "    try:\n",
    "        st = [s for s in ui_json(sc, \"/stages\") if s[\"stageId\"] == sid]\n",
    "    except Exception:                            # noqa: BLE001\n",
    "        st = []\n",
    "    if st:\n",
    "        s = st[0]\n",
    "        stage_rows.append({\"stage\": sid, \"name\": (s.get(\"name\") or \"\")[:58],\n",
    "                           \"tasks\": s.get(\"numTasks\"),\n",
    "                           \"shuffle write\": fmt_bytes(s.get(\"shuffleWriteBytes\")),\n",
    "                           \"shuffle read\": fmt_bytes(s.get(\"shuffleReadBytes\"))})\n",
    "table(stage_rows, [\"stage\", \"name\", \"tasks\", \"shuffle write\", \"shuffle read\"],\n",
    "      title=\"Q3d — the stages of that job (Spark UI numbers, via REST)\")\n",
    "print()\n",
    "print(\"reading: the stage that WRITES shuffle bytes carries the partial HashAggregate\")\n",
    "print(\"         (map-side combine, on the scan); the stage that READS them carries the\")\n",
    "print(\"         final HashAggregate, i.e. everything after the Exchange in the plan.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "q3-17",
   "metadata": {},
   "source": [
    "## Q3d — optimisation 1: `spark.sql.shuffle.partitions`\n",
    "\n",
    "The cluster default is 8 partitions; the Spark default is 200. On ~58 k rows, 200 partitions\n",
    "means 200 tiny tasks (scheduling overhead > work), while too few partitions under-uses the\n",
    "2 cores x N executors. AQE is switched **off** for this comparison, otherwise it would\n",
    "coalesce the 200 partitions at runtime and hide the effect being demonstrated — which is\n",
    "itself worth stating in the report.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "q3-18",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Q3d — shuffle partition count vs cost (AQE off)\n",
      "shuffle.partitions  seconds  stages   tasks  shuffle write\n",
      "----------------------------------------------------------\n",
      "               200    1.778       3     207       23.0 KiB\n",
      "                 8    0.142       3      15        5.6 KiB\n",
      "\n",
      "physical plan under spark.sql.shuffle.partitions=200 (first 9 lines):\n",
      "== Physical Plan ==\n",
      "*(2) HashAggregate(keys=[wiki#228], functions=[count(1), sum(CASE WHEN bot#233 THEN 1 ELSE 0 END)], output=[wiki#228, edits#7186L, bot_edits#7187L])\n",
      "+- Exchange hashpartitioning(wiki#228, 200), ENSURE_REQUIREMENTS, [plan_id=1956]\n",
      "   +- *(1) HashAggregate(keys=[wiki#228], functions=[partial_count(1), partial_sum(CASE WHEN bot#233 THEN 1 ELSE 0 END)], output=[wiki#228, count#7432L, sum#7433L])\n",
      "      +- *(1) Project [wiki#228, bot#233]\n",
      "         +- *(1) Filter (isnotnull(type#227) AND (type#227 = edit))\n",
      "            +- InMemoryTableScan [bot#233, type#227, wiki#228], [isnotnull(type#227), (type#227 = edit)]\n",
      "                  +- InMemoryRelation [id#226L, type#227, wiki#228, server_name#229, title#230, namespace#231, user#232, bot#233, minor#234, timestamp#235L, comment#236, length#237, kafka_partition#8, kafka_offset#9L, event_ts#238, selisih_byte#239L], StorageLevel(disk, memory, deserialized, 1 replicas)\n",
      "                        +- *(1) Project [e#7.id AS id#226L, e#7.type AS type#227, e#7.wiki AS wiki#228, e#7.server_name AS server_name#229, e#7.title AS title#230, e#7.namespace AS namespace#231, e#7.user AS user#232, e#7.bot AS bot#233, e#7.minor AS minor#234, e#7.timestamp AS timestamp#235L, e#7.comment AS comment#236, e#7.length AS length#237, kafka_partition#8, kafka_offset#9L, cast(e#7.timestamp as timestamp) AS event_ts#238, (e#7.length.new - coalesce(e#7.length.old, 0)) AS selisih_byte#239L]\n",
      "\n",
      "same plan under 8 partitions:\n",
      "== Physical Plan ==\n",
      "*(2) HashAggregate(keys=[wiki#228], functions=[count(1), sum(CASE WHEN bot#233 THEN 1 ELSE 0 END)], output=[wiki#228, edits#7926L, bot_edits#7927L])\n",
      "+- Exchange hashpartitioning(wiki#228, 8), ENSURE_REQUIREMENTS, [plan_id=2051]\n",
      "   +- *(1) HashAggregate(keys=[wiki#228], functions=[partial_count(1), partial_sum(CASE WHEN bot#233 THEN 1 ELSE 0 END)], output=[wiki#228, count#8172L, sum#8173L])\n",
      "      +- *(1) Project [wiki#228, bot#233]\n",
      "         +- *(1) Filter (isnotnull(type#227) AND (type#227 = edit))\n",
      "            +- InMemoryTableScan [bot#233, type#227, wiki#228], [isnotnull(type#227), (type#227 = edit)]\n",
      "                  +- InMemoryRelation [id#226L, type#227, wiki#228, server_name#229, title#230, namespace#231, user#232, bot#233, minor#234, timestamp#235L, comment#236, length#237, kafka_partition#8, kafka_offset#9L, event_ts#238, selisih_byte#239L], StorageLevel(disk, memory, deserialized, 1 replicas)\n",
      "                        +- *(1) Project [e#7.id AS id#226L, e#7.type AS type#227, e#7.wiki AS wiki#228, e#7.server_name AS server_name#229, e#7.title AS title#230, e#7.namespace AS namespace#231, e#7.user AS user#232, e#7.bot AS bot#233, e#7.minor AS minor#234, e#7.timestamp AS timestamp#235L, e#7.comment AS comment#236, e#7.length AS length#237, kafka_partition#8, kafka_offset#9L, cast(e#7.timestamp as timestamp) AS event_ts#238, (e#7.length.new - coalesce(e#7.length.old, 0)) AS selisih_byte#239L]\n"
     ]
    }
   ],
   "source": [
    "spark.conf.set(\"spark.sql.adaptive.enabled\", \"false\")\n",
    "results, plans = {}, {}\n",
    "for n in (200, 8):\n",
    "    spark.conf.set(\"spark.sql.shuffle.partitions\", str(n))\n",
    "    measure(sc, f\"(d) shuffle.partitions={n}\", lambda: spark.sql(agg_sql).count())\n",
    "    results[n] = RECORDS[-1]\n",
    "    plans[n] = physical_plan(spark.sql(agg_sql))       # plan as it was with that setting\n",
    "table([{\"shuffle.partitions\": n,\n",
    "        \"seconds\": r[\"seconds\"], \"stages\": r[\"stages\"], \"tasks\": r[\"tasks\"],\n",
    "        \"shuffle write\": fmt_bytes(r[\"shuffle_write\"])} for n, r in results.items()],\n",
    "      [\"shuffle.partitions\", \"seconds\", \"stages\", \"tasks\", \"shuffle write\"],\n",
    "      title=\"Q3d — shuffle partition count vs cost (AQE off)\")\n",
    "print()\n",
    "print(\"physical plan under spark.sql.shuffle.partitions=200 (first 9 lines):\")\n",
    "print(chr(10).join(plans[200].splitlines()[:9]))\n",
    "print()\n",
    "print(\"same plan under 8 partitions:\")\n",
    "print(chr(10).join(plans[8].splitlines()[:9]))\n",
    "spark.conf.set(\"spark.sql.shuffle.partitions\", \"8\")\n",
    "spark.conf.set(\"spark.sql.adaptive.enabled\", \"true\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "q3-19",
   "metadata": {},
   "source": [
    "## Q3d — optimisation 2: broadcasting a reference table\n",
    "\n",
    "A tiny `wiki → language` table joined to the big snapshot. Left as a normal join with\n",
    "broadcasting disabled, Spark has to **shuffle both sides** (`SortMergeJoin` + `Exchange`).\n",
    "With the table broadcast, every executor keeps a copy and the big side is never shuffled\n",
    "(`BroadcastHashJoin`, one `Exchange` fewer).\n",
    "\n",
    "The measured cost difference and the presence/absence of those operators is the evidence.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "q3-20",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "reference table rows: 26 (small enough to broadcast)\n",
      "Q3d — join with and without broadcasting the reference table\n",
      "       query  seconds  stages   tasks  shuffle read                        operators\n",
      "------------------------------------------------------------------------------------\n",
      "no broadcast    0.807       7      23      55.3 KiB      HashAggregate,SortMergeJoin\n",
      "BROADCAST(l)    0.524       4      17       2.0 KiB  BroadcastHashJoin,HashAggregate\n",
      "both plans returned the same numbers: True\n",
      "\n",
      "Q3d — edits per language (broadcast join result)\n",
      "    language   edits  bot_edits\n",
      "-------------------------------\n",
      "multilingual   18558       3818\n",
      "       other    2552       1119\n",
      "     English    2165        320\n",
      "      French     615        241\n",
      "      German     543         67\n",
      "     Chinese     435        188\n",
      "      Arabic     397        335\n",
      "     Russian     284         30\n",
      "    Japanese     267         43\n",
      "     Italian     227         40\n",
      "     Spanish     223         61\n",
      "        Urdu     222        212\n",
      "      Polish     193        118\n",
      "       Dutch     154         47\n",
      "      Korean     131         12\n",
      "  Portuguese     131         55\n",
      "     Swedish     102          0\n",
      "   Ukrainian      99          7\n",
      "      Hebrew      81         16\n",
      "     Turkish      76         43\n",
      "   Hungarian      69          6\n",
      "  Indonesian      65         13\n",
      "     Persian      57          2\n",
      "        Thai      42          5\n",
      "  Vietnamese      25          6\n",
      "     Finnish      20          6\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "'Q3d — edits per language (broadcast join result)\\n    language   edits  bot_edits\\n-------------------------------\\nmultilingual   18558       3818\\n       other    2552       1119\\n     English    2165        320\\n      French     615        241\\n      German     543         67\\n     Chinese     435        188\\n      Arabic     397        335\\n     Russian     284         30\\n    Japanese     267         43\\n     Italian     227         40\\n     Spanish     223         61\\n        Urdu     222        212\\n      Polish     193        118\\n       Dutch     154         47\\n      Korean     131         12\\n  Portuguese     131         55\\n     Swedish     102          0\\n   Ukrainian      99          7\\n      Hebrew      81         16\\n     Turkish      76         43\\n   Hungarian      69          6\\n  Indonesian      65         13\\n     Persian      57          2\\n        Thai      42          5\\n  Vietnamese      25          6\\n     Finnish      20          6'"
      ]
     },
     "execution_count": 11,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "LANG = {\n",
    "    \"wikidatawiki\": \"multilingual\", \"commonswiki\": \"multilingual\",\n",
    "    \"enwiki\": \"English\", \"idwiki\": \"Indonesian\", \"dewiki\": \"German\", \"frwiki\": \"French\",\n",
    "    \"ruwiki\": \"Russian\", \"zhwiki\": \"Chinese\", \"jawiki\": \"Japanese\", \"itwiki\": \"Italian\",\n",
    "    \"eswiki\": \"Spanish\", \"arwiki\": \"Arabic\", \"nlwiki\": \"Dutch\", \"plwiki\": \"Polish\",\n",
    "    \"ptwiki\": \"Portuguese\", \"trwiki\": \"Turkish\", \"hewiki\": \"Hebrew\", \"huwiki\": \"Hungarian\",\n",
    "    \"fawiki\": \"Persian\", \"kowiki\": \"Korean\", \"viwiki\": \"Vietnamese\", \"thwiki\": \"Thai\",\n",
    "    \"svwiki\": \"Swedish\", \"ukwiki\": \"Ukrainian\", \"urwiki\": \"Urdu\", \"fiwiki\": \"Finnish\",\n",
    "}\n",
    "ref = spark.createDataFrame(sorted(LANG.items()), [\"wiki\", \"language\"])\n",
    "ref.createOrReplaceTempView(\"wiki_lang\")\n",
    "print(\"reference table rows:\", ref.count(), \"(small enough to broadcast)\")\n",
    "\n",
    "out_agg = \"\"\"COUNT(*)                      AS edits,\n",
    "       SUM(CASE WHEN e.bot THEN 1 ELSE 0 END) AS bot_edits\"\"\"\n",
    "join_sql = (\n",
    "    \"SELECT {hint} COALESCE(l.language, 'other') AS language, \" + out_agg + chr(10) +\n",
    "    \"FROM wiki_edits e\" + chr(10) +\n",
    "    \"LEFT JOIN wiki_lang l ON e.wiki = l.wiki\" + chr(10) +\n",
    "    \"WHERE e.type = 'edit'\" + chr(10) +\n",
    "    \"GROUP BY COALESCE(l.language, 'other')\")\n",
    "\n",
    "orig_bcast = spark.conf.get(\"spark.sql.autoBroadcastJoinThreshold\")\n",
    "\n",
    "# --- baseline: broadcasting disabled -> SortMergeJoin + exchange of both sides\n",
    "spark.conf.set(\"spark.sql.autoBroadcastJoinThreshold\", \"-1\")\n",
    "base_df = spark.sql(join_sql.format(hint=\"\"))\n",
    "base_plan = plan_text(base_df, \"formatted\")\n",
    "base_rows = measure(sc, \"(d) join, no broadcast\", lambda: base_df.collect())\n",
    "base_rec = RECORDS[-1]\n",
    "\n",
    "# --- optimised: broadcast hint (threshold restored)\n",
    "spark.conf.set(\"spark.sql.autoBroadcastJoinThreshold\", orig_bcast)\n",
    "opt_df = spark.sql(join_sql.format(hint=\"/*+ BROADCAST(l) */\"))\n",
    "opt_plan = plan_text(opt_df, \"formatted\")\n",
    "opt_rows = measure(sc, \"(d) join, broadcast\", lambda: opt_df.collect())\n",
    "opt_rec = RECORDS[-1]\n",
    "\n",
    "def ops(plan):\n",
    "    found = set()\n",
    "    for op in (\"SortMergeJoin\", \"BroadcastHashJoin\", \"HashAggregate\"):\n",
    "        if op in plan:\n",
    "            found.add(op)\n",
    "    if re.search(r\"\bExchange\b\", plan):      # not \"BroadcastExchange\"\n",
    "        found.add(\"Exchange\")\n",
    "    return found\n",
    "\n",
    "table([{\"query\": \"no broadcast\", \"seconds\": base_rec[\"seconds\"],\n",
    "        \"stages\": base_rec[\"stages\"], \"tasks\": base_rec[\"tasks\"],\n",
    "        \"shuffle read\": fmt_bytes(base_rec[\"shuffle_read\"]),\n",
    "        \"operators\": \",\".join(sorted(ops(base_plan)))},\n",
    "       {\"query\": \"BROADCAST(l)\", \"seconds\": opt_rec[\"seconds\"],\n",
    "        \"stages\": opt_rec[\"stages\"], \"tasks\": opt_rec[\"tasks\"],\n",
    "        \"shuffle read\": fmt_bytes(opt_rec[\"shuffle_read\"]),\n",
    "        \"operators\": \",\".join(sorted(ops(opt_plan)))}],\n",
    "      [\"query\", \"seconds\", \"stages\", \"tasks\", \"shuffle read\", \"operators\"],\n",
    "      title=\"Q3d — join with and without broadcasting the reference table\")\n",
    "\n",
    "same = sorted([(r[\"language\"], r[\"edits\"], r[\"bot_edits\"]) for r in base_rows]) == \\\n",
    "       sorted([(r[\"language\"], r[\"edits\"], r[\"bot_edits\"]) for r in opt_rows])\n",
    "print(\"both plans returned the same numbers:\", same)\n",
    "print()\n",
    "table(sorted(opt_rows, key=lambda r: (-r[\"edits\"], r[\"language\"])),\n",
    "      [\"language\", \"edits\", \"bot_edits\"],\n",
    "      title=\"Q3d — edits per language (broadcast join result)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "q3-21",
   "metadata": {},
   "source": [
    "## Summary\n",
    "\n",
    "Each cell above answers one sub-question; this last cell writes the numbers to\n",
    "`q3_results.json` next to the Q2 results, so the report can cite them without re-running.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "q3-22",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "written: /tmp/spark-events/q3/q3_results.json\n",
      "\n",
      "numbers to cite in the report:\n",
      "  rows           : 57,778 (unparsable 0)\n",
      "  k (spikes)     : 6 edits / 5 min  [p99]\n",
      "  spikes found   : 247 page-windows\n",
      "  RDD == SQL     : True\n",
      "  broadcast join : 0.807s -> 0.524s, join type ['SortMergeJoin'] -> ['BroadcastHashJoin'], shuffle read 55.3 KiB -> 2.0 KiB\n",
      "  (the remaining Exchange is the hashpartitioning of the final GROUP BY by language;\n",
      "   the exchange that disappeared is the one that shuffled the big side of the join)\n"
     ]
    }
   ],
   "source": [
    "Q3_OUT.parent.mkdir(parents=True, exist_ok=True)\n",
    "out = {\n",
    "    \"app_id\": sc.applicationId,\n",
    "    \"messages\": total,\n",
    "    \"unparsable\": bad,\n",
    "    \"b1_rows\": len(per_minute), \"b1_minutes\": int(per_minute[\"minute\"].nunique()),\n",
    "    \"b2\": [{k: v for k, v in r.asDict().items()} for r in bot_rows],\n",
    "    \"rdd_vs_sql_identical\": [tuple(x) for x in rdd_human] == sql_human,\n",
    "    \"b3\": [{k: v for k, v in r.asDict().items()} for r in size_rows],\n",
    "    \"b4\": [{k: v for k, v in r.asDict().items()} for r in editor_rows],\n",
    "    \"c\": {\"k\": k, \"rule\": rule, \"distribution\": d, \"spikes\": [\n",
    "        {\"wiki\": s[\"wiki\"], \"title\": s[\"title\"], \"edits\": s[\"edits\"],\n",
    "         \"window_start\": str(s[\"window_start\"]), \"window_end\": str(s[\"window_end\"])}\n",
    "        for s in spikes]},\n",
    "    \"d\": {\"records\": RECORDS, \"broadcast_same_result\": same,\n",
    "          \"operators\": {\"baseline\": sorted(ops(base_plan)), \"optimised\": sorted(ops(opt_plan))}},\n",
    "}\n",
    "Q3_OUT.write_text(json.dumps(out, indent=1, default=str))\n",
    "print(\"written:\", Q3_OUT)\n",
    "print()\n",
    "print(\"numbers to cite in the report:\")\n",
    "print(f\"  rows           : {total:,} (unparsable {bad})\")\n",
    "print(f\"  k (spikes)     : {k} edits / 5 min  [{rule}]\")\n",
    "print(f\"  spikes found   : {len(spikes)} page-windows\")\n",
    "print(f\"  RDD == SQL     : {[tuple(x) for x in rdd_human] == sql_human}\")\n",
    "print(f\"  broadcast join : {base_rec['seconds']}s -> {opt_rec['seconds']}s, \"\n",
    "      f\"join type {sorted(ops(base_plan) & {'SortMergeJoin'})} -> \"\n",
    "      f\"{sorted(ops(opt_plan) & {'BroadcastHashJoin'})}, \"\n",
    "      f\"shuffle read {fmt_bytes(base_rec['shuffle_read'])} -> {fmt_bytes(opt_rec['shuffle_read'])}\")\n",
    "print(\"  (the remaining Exchange is the hashpartitioning of the final GROUP BY by language;\")\n",
    "print(\"   the exchange that disappeared is the one that shuffled the big side of the join)\")"
   ]
  },
