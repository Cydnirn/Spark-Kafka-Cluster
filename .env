# ---------------------------------------------------------------------------
# Defaults for the Spark + Kafka experiment cluster. Docker Compose loads this
# file automatically; edit values here (or override in your shell) to change
# the shape of the cluster. No secrets are stored in this file by design.
# ---------------------------------------------------------------------------

# --- Spark ------------------------------------------------------------------
SPARK_IMAGE=apache/spark:4.1.3-scala2.13-java17-python3-ubuntu
# The address Spark binds AND advertises, and the address every node dials:
#   localhost            -> single host, nothing exposed to the LAN
#   the master's LAN IP  -> cluster; put the SAME value in the .env on EVERY
#                           node so master, workers and drivers agree, and open
#                           7077/TCP on the master machine.
# Spark containers use host networking, so the ports below sit on the machine
# itself rather than being remapped by Compose.
SPARK_MASTER_IP=localhost
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
# This node's OWN address, as Spark should identify and advertise it. Equal to
# SPARK_MASTER_IP on the master machine; on a worker-only machine it is that
# machine's LAN IP. Required under host networking (Spark otherwise fails to
# resolve the container hostname).
SPARK_LOCAL_IP=localhost
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Spark version of the Kafka connector (must match SPARK_IMAGE's Spark version)
SPARK_CONNECTOR_VERSION=4.1.3

# --- JupyterLab -------------------------------------------------------------
JUPYTER_IMAGE=spark-kafka-jupyter:4.1.3
# JupyterLab listens on :8888 of the host directly (host networking; the port is
# pinned in jupyter/Dockerfile's CMD).

# --- Kafka (single-node KRaft) ---------------------------------------------
KAFKA_IMAGE=apache/kafka:4.3.2
# Broker port on the machine itself — host networking, nothing remapped.
KAFKA_PORT=29092
# Address the broker advertises to clients: `localhost` on a single host, the
# machine's LAN IP so clients on other machines can follow the metadata.
KAFKA_ADVERTISE_HOST=localhost
# Where Spark jobs (and the examples) look for Kafka. It has to match what the
# broker advertises: localhost:29092 here, <lan-ip>:29092 in a cluster.
KAFKA_BOOTSTRAP=localhost:29092
# Must be a 22-char base64 UUID; keep it stable or the broker reformats storage.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- optional tooling (docker compose --profile tools up -d) ----------------
SPARK_HISTORY_UI_PORT=18080
KAFKA_UI_IMAGE=kafbat/kafka-ui:v1.5.0
KAFKA_UI_PORT=8090
BUSYBOX_IMAGE=busybox:1.37
