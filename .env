# ---------------------------------------------------------------------------
# Defaults for the Spark + Kafka experiment cluster. Docker Compose loads this
# file automatically; edit values here (or override in your shell) to change
# the shape of the cluster. No secrets are stored in this file by design.
# ---------------------------------------------------------------------------

# --- Spark ------------------------------------------------------------------
SPARK_IMAGE=apache/spark:4.1.3-scala2.13-java17-python3-ubuntu
# Address (Compose service name or LAN IP) that workers use to reach the
# master. Single host: leave as spark-master. Multi-host: the master machine's
# LAN IP, the same value in the .env on EVERY node — each worker dials
# spark://$SPARK_MASTER_IP:7077, so 7077 must be reachable from the worker
# (open the firewall). The master itself keeps advertising its container name;
# see the comment in docker-compose.yml.
SPARK_MASTER_IP=spark-master
# Host-side ports only: the cluster always talks 7077/8080/8081 inside the network.
SPARK_MASTER_HOST_PORT=7077
SPARK_MASTER_UI_HOST_PORT=8080
SPARK_WORKER_UI_HOST_PORT=8081
# Driver ports published by spark-master so executors on other machines can
# connect back to a driver started in that container (LAN clusters only).
SPARK_DRIVER_PORT=7078
SPARK_BLOCKMANAGER_PORT=7079
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Spark version of the Kafka connector (must match SPARK_IMAGE's Spark version)
SPARK_CONNECTOR_VERSION=4.1.3

# --- JupyterLab -------------------------------------------------------------
JUPYTER_IMAGE=spark-kafka-jupyter:4.1.3
JUPYTER_HOST_PORT=8888

# --- Kafka (single-node KRaft) ---------------------------------------------
KAFKA_IMAGE=apache/kafka:4.3.2
KAFKA_HOST_PORT=29092
# Must be a 22-char base64 UUID; keep it stable or the broker reformats storage.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- optional tooling (docker compose --profile tools up -d) ----------------
SPARK_HISTORY_UI_HOST_PORT=18080
KAFKA_UI_IMAGE=kafbat/kafka-ui:v1.5.0
KAFKA_UI_PORT=8090
BUSYBOX_IMAGE=busybox:1.37
